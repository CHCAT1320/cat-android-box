{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cat-android-box",
  "version": "0.1.5",
  "identifier": "com.chcat1320.cat-android-box",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "cat-android-box",
        "width": 1000,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "resources": {
      "../tools/adb.exe": "tools/adb.exe",
      "../tools/fastboot.exe": "tools/fastboot.exe",
      "../tools/AdbWinApi.dll": "tools/AdbWinApi.dll",
      "../tools/AdbWinUsbApi.dll": "tools/AdbWinUsbApi.dll",
      "../tools/scrcpy.exe": "tools/scrcpy.exe",
      "../tools/scrcpy-server": "tools/scrcpy-server",
      "../tools/SDL3.dll": "tools/SDL3.dll",
      "../tools/avcodec-63.dll": "tools/avcodec-63.dll",
      "../tools/avformat-63.dll": "tools/avformat-63.dll",
      "../tools/avutil-61.dll": "tools/avutil-61.dll",
      "../tools/swresample-7.dll": "tools/swresample-7.dll",
      "../tools/libusb-1.0.dll": "tools/libusb-1.0.dll",
      "../tools/scrcpy.png": "tools/scrcpy.png",
      "../tools/disconnected.png": "tools/disconnected.png",
      "../tools/LICENSE-scrcpy.txt": "tools/LICENSE-scrcpy.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGMkJBRjFGREU0MEMyNzMKUldSendrRGVINjhydi9GKzZpOW95bWhhd1hhOUJMbGFqaVhMVDk4bVhSSmxXZFR2eWFyTzJ1OVMK",
      "endpoints": [
        "https://github.com/CHCAT1320/cat-android-box/releases/latest/download/latest.json"
      ]
    }
  }
}
